# Copy this file to .env and fill in real values. NEVER commit .env.
# Generate a key with:  py -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=sqlite:///secureshop.db
SESSION_COOKIE_SECURE=false
SESSION_MINUTES=30

# Email for confirmation/reset links. Leave MAIL_SERVER empty in development:
# links are then written to the development log only.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@secureshop.local
